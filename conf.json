{
  "tags": {
    "allowUnknownTags": true,
    "dictionaries": ["jsdoc", "closure"]
  },
  "source": {
    "include": ["src", "README.md"],
    "exclude": ["node_modules", "docs"],
    "includePattern": "\\.js$",
    "excludePattern": "(node_modules|docs|dist|build)"
  },
  "plugins": ["plugins/markdown", "jsdoc-vuex-plugin"],
  "templates": {
    "cleverLinks": true,
    "monospaceLinks": true,
    "default": {
      "outputSourceFiles": true,
      "includeDate": false
    }
  },
  "opts": {
    "template": "node_modules/docdash",
    "encoding": "utf8",
    "destination": "./docs/",
    "recurse": true,
    "verbose": true,
    "readme": "README.md"
  },
  "docdash": {
    "static": true,
    "sort": true,
    "search": true,
    "collapse": true,
    "wrap": true,
    "typedefs": true,
    "removeQuotes": "none",
    "scripts": [],
    "menu": {
      "GitHub": {
        "href": "https://github.com/ruxailab/RUXAILAB",
        "target": "_blank",
        "class": "menu-item",
        "id": "repository"
      }
    }
  }
}
