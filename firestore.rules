rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Any login, including the anonymous accounts used to answer a study
    // from an invitation link that does not require login.
    function authenticated() {
      return request.auth != null;
    }

    // A real account. Everything except answering an invited study needs one.
    function signedIn() {
      return authenticated() &&
        request.auth.token.get('firebase', {})
          .get('sign_in_provider', '') != 'anonymous';
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return signedIn() &&
        currentUser().data.accessLevel == 0;
    }

    function roleFor(study) {
      return authenticated() &&
        study.studyRoleMap is map &&
        request.auth.uid in study.studyRoleMap
          ? study.studyRoleMap[request.auth.uid]
          : null;
    }

    function isOwner(study) {
      return signedIn() &&
        study.testAdmin.userDocId == request.auth.uid;
    }

    function isAdmin(study) {
      return isSuperAdmin() || isOwner(study) || roleFor(study) == 0;
    }

    function canReadStudy(study) {
      let role = roleFor(study);
      let type = study.get('testType', '');
      return (signedIn() && study.get('isPublic', false) == true) ||
        (authenticated() && (isAdmin(study) || role == 4 ||
          (type == 'USER' && role in [3, 5]) ||
          (type == 'FOCUS_GROUP' && role in [1, 3]) ||
          (type in ['HEURISTIC', 'CARD_SORTING'] && role in [1, 2])));
    }

    function isSessionMember(session) {
      let email = request.auth.token.get('email', '');
      return signedIn() && (
        request.auth.uid in session.get('staffIds', []) ||
        request.auth.uid in session.get('participantIds', []) ||
        (email != '' && email in session.get('staffEmails', [])) ||
        (email != '' && email in session.get('participantEmails', []))
      );
    }

    function isStudySessionAdmin(studyId) {
      return signedIn() && isAdmin(
        get(/databases/$(database)/documents/tests/$(studyId)).data
      );
    }

    function canViewLogs(study) {
      return isAdmin(study);
    }

    match /users/{userId} {
      // Study staff keep a collaborator's study pointers inside that
      // collaborator's own user document (invite, role change, participant
      // removal), so a cross-user update stays possible, but only for those
      // two membership maps. Profile fields and the storage counter are
      // owner-only.
      function onlyStudyMembershipChanged() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['myTests', 'myAnswers']);
      }

      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.accessLevel == 1;
      allow read: if signedIn();
      allow update: if isSuperAdmin() || (
        signedIn() &&
        request.resource.data.accessLevel == resource.data.accessLevel &&
        (request.auth.uid == userId || onlyStudyMembershipChanged())
      );
      allow delete: if isSuperAdmin() ||
        (signedIn() && request.auth.uid == userId);

      match /notifications/{notificationId} {
        allow read, write, delete: if signedIn()
      }
    }

    match /tests/{studyId} {
      allow create: if signedIn() &&
        request.resource.data.testAdmin.userDocId == request.auth.uid &&
        request.resource.data.studyRoleMap is map;
      // A missing study reads as "not found" instead of "permission denied",
      // so the client can tell a wrong link apart from a study it can't open.
      allow read: if resource == null || canReadStudy(resource.data);
      // RBAC changes and study edits go through trusted callable operations.
      // In particular, a client must not be able to promote itself by editing
      // studyRoleMap, even if it currently has a Manager/Admin role.
      allow update: if false;
      allow delete: if isAdmin(resource.data);

      match /sessions/{sessionId} {
        // Check the session-scoped grant first. Collection-group queries by
        // invited attendees must not need a read of the parent study, which
        // those attendees may intentionally be unable to read directly.
        allow read: if isSessionMember(resource.data) ||
          isStudySessionAdmin(studyId);
        allow create, update, delete: if isStudySessionAdmin(studyId);
      }

      // Invitations and memberships are managed only by trusted functions.
      match /participants/{participantId} {
        allow read: if signedIn();
        allow write: if false;
      }

      match /auditTrail/{eventId} {
        allow read: if signedIn() &&
          get(/databases/$(database)/documents/tests/$(studyId))
            .data.testAdmin.userDocId == request.auth.uid;
        allow write: if false;
      }

      match /logs/{logId} {
        allow read: if canViewLogs(
          get(/databases/$(database)/documents/tests/$(studyId)).data
        );
        allow write: if false;
      }

      match /logBatches/{batchId} {
        allow read, write: if false;
      }

      match /loggingMeta/{metadataId} {
        allow read, write: if false;
      }

      match /studySessions/{sessionId} {
        allow read: if canViewLogs(
          get(/databases/$(database)/documents/tests/$(studyId)).data
        );
        allow write: if false;
      }

      // Phone pairing for unmoderated task instructions. Not a study session.
      // Only the owning participant can read the companion. Nobody writes it
      // from the client. The document id is the uid.
      match /mobileTaskCompanions/{companionId} {
        allow read: if authenticated() &&
          request.auth.uid == companionId &&
          (resource == null ||
            resource.data.participantUid == request.auth.uid);
        allow write: if false;
      }

      // Public phone projection. The document id is the pairing token, so
      // knowing the path is the capability. Clients may get one document;
      // they must not list the collection or write it.
      match /mobileTaskViews/{viewId} {
        allow get: if viewId.matches('^[a-f0-9]{64}$');
        allow list, write: if false;
      }

    }

    match /answers/{answerId} {
<<<<<<< HEAD
