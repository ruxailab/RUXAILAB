      }

      function canUpdateAnswer() {
        let study = get(
          /databases/$(database)/documents/tests/$(resource.data.studyId)
        ).data;

        let changed = request.resource.data
          .diff(resource.data)
          .affectedKeys();

        return (
          authenticated() &&
          isAdmin(study)
        ) || (
          authenticated() && (
            (
              changed.hasOnly(['taskAnswers']) &&
              canUpdateOwnAnswer('taskAnswers')
            ) ||
            (
              changed.hasOnly(['heuristicAnswers']) &&
              canUpdateOwnAnswer('heuristicAnswers')
            ) ||
            (
              changed.hasOnly(['cardSortingAnswers']) &&
              canUpdateOwnAnswer('cardSortingAnswers')
            ) || 
            (
              changed.hasOnly(['sessions', 'themes'])
            )
          )
        );
      }
      allow create: if signedIn();
      allow read: if authenticated();
      allow update: if canUpdateAnswer();      
      allow delete: if signedIn() &&
        resource.data.studyId != null &&
        get(
          /databases/$(database)/documents/tests/$(resource.data.studyId)
        ).data.testAdmin.userDocId == request.auth.uid;

      match /analytics/{analyticsId} {
        allow read: if authenticated();
      }
    }

    // Existing non-study modules retain authenticated access. Their
    // collection-specific authorization is outside the study RBAC policy.
    match /templates/{document=**} {
      allow read, write: if signedIn();
    }
    match /assessments/{document=**} {
      allow read, write: if signedIn();
    }
    match /report/{document=**} {
      allow read, write: if signedIn();
    }
    match /audioSentiment/{document=**} {
      allow read, write: if signedIn();
    }
    match /sentiment/{document=**} {
      allow read, write: if signedIn();
    }
    match /transcriptions/{document=**} {
      allow read, write: if signedIn();
    }
    match /jobs/{jobId} {
      // A queued job names the participant, the study and the answers
      // document it was created for, so it is readable only by the account
      // that queued it and by study staff who can open the study dashboard.
      // Scoping this per document is also what stops a bare collection read:
      // a listing only succeeds when every matched document passes.
      function jobStudy() {
        return get(
          /databases/$(database)/documents/tests/$(resource.data.studyId)
        ).data;
      }

      function canReadJobStudy() {
        return resource.data.get('studyId', null) != null &&
          exists(
            /databases/$(database)/documents/tests/$(resource.data.studyId)
          ) &&
          (isAdmin(jobStudy()) || roleFor(jobStudy()) in [3, 4]);
      }

      allow read: if signedIn() && (
        resource.data.get('uid', '') == request.auth.uid ||
        canReadJobStudy()
      );
      allow write: if false;
    }
    match /calibrations/{document=**} {
      allow read, write: if signedIn();
    }
    // Invitation tokens grant study access, so only trusted functions read
    // or write them (validateInvite / resolveInvite check a token).
    match /invites/{inviteId} {
      allow read, write: if false;
    }
    match /agents/{agentId} {
      allow read, write: if signedIn();
    }
    match /settings/{settingId} {
      allow read: if signedIn();
    }
    match /{path=**}/sessions/{sessionId} {
      allow read: if isSessionMember(resource.data);
      allow write: if false;
    }
  }
}
