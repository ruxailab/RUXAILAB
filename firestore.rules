rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return signedIn() &&
        currentUser().data.accessLevel == 0;
    }

    function roleFor(study) {
      return signedIn() &&
        study.studyRoleMap is map &&
        request.auth.uid in study.studyRoleMap
          ? study.studyRoleMap[request.auth.uid]
          : null;
    }

    function isOwner(study) {
      return signedIn() &&
        study.testAdmin.userDocId == request.auth.uid;
    }

    function isAdmin(study) {
      return isSuperAdmin() || isOwner(study) || roleFor(study) == 0;
    }

    function isManager(study) {
      return roleFor(study) == 4;
    }

    function canViewLogs(study) {
      return isAdmin(study);
    }

    function managerChangedOnlyStudyContent() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'testTitle',
        'testDescription',
        'testStructure',
        'testOptions',
        'studyConclusion',
        'evaluatorInfo',
        'updateDate'
      ]);
    }

    match /users/{userId} {
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.accessLevel == 1;
      allow read: if signedIn();
      allow update: if isSuperAdmin() || (
        signedIn() &&
        request.resource.data.accessLevel == resource.data.accessLevel
      );
      allow delete: if isSuperAdmin() ||
        (signedIn() && request.auth.uid == userId);

      match /notifications/{notificationId} {
        allow read: if signedIn() &&
          request.auth.uid == userId;

        allow create: if false;

        allow update: if signedIn() &&
          request.auth.uid == userId;

        allow delete: if signedIn() &&
          request.auth.uid == userId;
      }
    }

    match /tests/{studyId} {
      allow create: if signedIn() &&
        request.resource.data.testAdmin.userDocId == request.auth.uid &&
        request.resource.data.studyRoleMap is map;
      allow read: if true;
      allow update: if isAdmin(resource.data) ||
        (isManager(resource.data) && managerChangedOnlyStudyContent());
      allow delete: if isAdmin(resource.data);

      match /sessions/{sessionId} {
        allow write: if signedIn();
        allow read: if true;
      }

      match /participants/{participantId} {
        allow read, write: if signedIn();
      }

      match /auditTrail/{eventId} {
        allow read: if signedIn() &&
          get(/databases/$(database)/documents/tests/$(studyId))
            .data.testAdmin.userDocId == request.auth.uid;
        allow write: if false;
      }

      match /logs/{logId} {
        allow read: if canViewLogs(
          get(/databases/$(database)/documents/tests/$(studyId)).data
        );
        allow write: if false;
      }

      match /logBatches/{batchId} {
        allow read, write: if false;
      }

      match /loggingMeta/{metadataId} {
        allow read, write: if false;
      }

      match /studySessions/{sessionId} {
        allow read: if canViewLogs(
          get(/databases/$(database)/documents/tests/$(studyId)).data
        );
        allow write: if false;
      }

      match /participants/{participantId} {
        allow read: if signedIn();
      }

      match /sessions/{sessionId} {
        allow read, write: if signedIn();
      }
    }

    match /answers/{answerId} {
      function answerStudy() {
        return get(
          /databases/$(database)/documents/tests/$(resource.data.studyId)
        ).data;
      }

      allow create: if signedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.studyId == null;
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'taskAnswers',
            'heuristicAnswers',
            'studyId'
      		]);
      allow delete: if (
        signedIn() &&
        resource.data.studyId == null &&
        resource.data.createdBy == request.auth.uid
      ) || isAdmin(answerStudy());

       match /analytics/{analyticsId} {
          allow read: if true;
        }
    }

    // Existing non-study modules retain authenticated access. Their
    // collection-specific authorization is outside the study RBAC policy.
    match /templates/{document=**} {
      allow read, write: if signedIn();
    }
    match /assessments/{document=**} {
      allow read, write: if signedIn();
    }
    match /report/{document=**} {
      allow read, write: if signedIn();
    }
    match /audioSentiment/{document=**} {
      allow read, write: if signedIn();
    }
    match /transcriptions/{document=**} {
      allow read, write: if signedIn();
    }
    match /calibrations/{document=**} {
      allow read, write: if signedIn();
    }
    match /invites/{inviteId} {
      allow write: if signedIn();
      allow read: if true;
    }
    match /agents/{agentId} {
      allow read, write: if signedIn();
    }
    match /settings/{settingId} {
      allow read: if signedIn();
    }
    match /{path=**}/sessions/{sessionId} {
      allow write: if signedIn();
      allow read: if true;
    }
  }
}
