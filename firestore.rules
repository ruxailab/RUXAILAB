rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return signedIn() &&
        currentUser().data.accessLevel == 0;
    }

    function roleFor(study) {
      return signedIn() &&
        study.studyRoleMap is map &&
        request.auth.uid in study.studyRoleMap
          ? study.studyRoleMap[request.auth.uid]
          : null;
    }

    function isOwner(study) {
      return signedIn() &&
        study.testAdmin.userDocId == request.auth.uid;
    }

    function isAdmin(study) {
      return isSuperAdmin() || isOwner(study) || roleFor(study) == 0;
    }

    function isManager(study) {
      return roleFor(study) == 4;
    }

    function isStudyMember(study) {
      return
        (study.testType == 'USER' && roleFor(study) in [0, 3, 4, 5]) ||
        ((study.testType == 'HEURISTIC' || study.testType == 'HEURISTICS') &&
          roleFor(study) in [0, 1, 2, 4]);
    }

    function isUserStudy(study) {
      return study.testType == 'USER';
    }

    function isHeuristicStudy(study) {
      return study.testType == 'HEURISTIC' ||
        study.testType == 'HEURISTICS';
    }

    function isRbacStudy(study) {
      return isUserStudy(study) || isHeuristicStudy(study);
    }

    function canViewDashboard(study) {
      return isAdmin(study) || isManager(study) ||
        (isUserStudy(study) && roleFor(study) == 3) ||
        (isHeuristicStudy(study) && roleFor(study) in [1, 2]);
    }

    function canViewAnswers(study) {
      return isAdmin(study) || isManager(study) ||
        (isUserStudy(study) && roleFor(study) == 3) ||
        (isHeuristicStudy(study) && roleFor(study) in [1, 2]);
    }

    function canAnswer() {
      return true
    }

    function managerChangedOnlyStudyContent() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'testTitle',
        'testDescription',
        'testStructure',
        'testOptions',
        'studyConclusion',
        'evaluatorInfo',
        'updateDate'
      ]);
    }

    match /users/{userId} {
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.accessLevel == 1;
      allow read: if signedIn();
      allow update: if isSuperAdmin() || (
        signedIn() &&
        request.resource.data.accessLevel == resource.data.accessLevel
      );
      allow delete: if isSuperAdmin() ||
        (signedIn() && request.auth.uid == userId);
    }

    match /tests/{studyId} {
      allow create: if signedIn() &&
        request.resource.data.testAdmin.userDocId == request.auth.uid &&
        request.resource.data.studyRoleMap is map;
      allow read: if true;
      allow update: if !isRbacStudy(resource.data) && (
        isAdmin(resource.data) ||
        (isManager(resource.data) && managerChangedOnlyStudyContent())
      );
      allow delete: if isAdmin(resource.data);

      match /sessions/{sessionId} {
        allow read, write: if signedIn();
      }

      match /participants/{participantId} {
        allow read, write: if signedIn();
      }

      match /auditTrail/{eventId} {
        allow read: if signedIn() &&
          get(/databases/$(database)/documents/tests/$(studyId))
            .data.testAdmin.userDocId == request.auth.uid;
        allow write: if false;
      }

      match /logs/{logId} {
        allow read: if canViewDashboard(
          get(/databases/$(database)/documents/tests/$(studyId)).data
        );
        allow write: if false;
      }

      match /logBatches/{batchId} {
        allow read: if canViewDashboard(
          get(/databases/$(database)/documents/tests/$(studyId)).data
        );
        allow write: if false;
      }

      match /participants/{participantId} {
        allow read: if signedIn();
      }
    }

    match /answers/{answerId} {
      function answerStudy() {
        return get(
          /databases/$(database)/documents/tests/$(resource.data.studyId)
        ).data;
      }

      allow create: if signedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.studyId == null;
      allow read: if canViewAnswers(answerStudy());
      allow update: if
        canAnswer() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'taskAnswers',
            'heuristicAnswers'
      		]);
      allow delete: if (
        resource.data.studyId == null &&
        resource.data.createdBy == request.auth.uid
      ) || isAdmin(answerStudy());
    }

    // Existing non-study modules retain authenticated access. Their
    // collection-specific authorization is outside the study RBAC policy.
    match /templates/{document=**} {
      allow read, write: if signedIn();
    }
    match /assessments/{document=**} {
      allow read, write: if signedIn();
    }
    match /report/{document=**} {
      allow read, write: if signedIn();
    }
    match /audioSentiment/{document=**} {
      allow read, write: if signedIn();
    }
    match /transcriptions/{document=**} {
      allow read, write: if signedIn();
    }
    match /calibrations/{document=**} {
      allow read, write: if signedIn();
    }
    match /invites/{inviteId} {
      allow read, write: if signedIn();
    }
    match /agents/{agentId} {
      allow read, write: if signedIn();
    }
    match /settings/{settingId} {
      allow read: if signedIn();
    }
    match /{path=**}/sessions/{sessionId} {
      allow read: if signedIn();
    }
  }
}
