{
  "name": "ruxailab",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "serve": "vue-cli-service serve",
    "lint": "eslint src --ext .js,.vue",
    "lint:fix": "eslint src --ext .js,.vue --fix",
    "i18n:report": "vue-cli-service i18n:report --src './src/**/*.?(js|vue)' --locales './src/locales/**/*.json'",
    "doc": "jsdoc -c conf.json",
    "test": "vue-cli-service test:unit",
    "test:rules": "firebase emulators:exec --project demo-ruxailab-rbac --only firestore,storage \"./node_modules/.bin/jest --config jest.rules.config.js --runInBand\"",
    "build-dev": "vue-cli-service build --mode development",
    "build-prod": "vue-cli-service build --mode production",
    "cypress:open": "cypress open",
    "deploy-dev": "firebase use dev && firebase deploy --only hosting:ruxailab-dev",
    "deploy-develop": "firebase use develop && firebase deploy --only hosting:ruxailab-develop",
    "deploy-prod": "firebase use prod && firebase deploy --only hosting:ruxailab-prod"
  },
  "dependencies": {
    "@mediapipe/face_mesh": "^0.4.1633559619",
    "@tensorflow-models/face-landmarks-detection": "^1.0.6",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@tiptap/core": "^2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@tiptap/vue-3": "^2.27.2",
    "@vue/babel-plugin-jsx": "^2.0.1",
    "@vueup/vue-quill": "^1.5.3",
    "axios": "^1.19.0",
    "buffer": "^6.0.3",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "crypto-browserify": "^3.12.1",
    "date-fns": "^4.3.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^6.6.0",
    "gsap": "^3.15.0",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.7",
    "livekit-client": "^2.21.0",
    "lodash": "^4.18.1",
    "nanoid": "^6.0.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "uid-generator": "^2.0.0",
    "vue": "^3.5.41",
    "vue-chartjs": "^5.3.4",
    "vue-i18n": "^11.4.8",
    "vue-loader": "^17.4.2",
    "vue-router": "^4.6.4",
    "vue-toastification": "^2.0.0-rc.5",
    "vue3-quill": "^0.3.1",
    "vue3-text-clamp": "^0.1.2",
    "vuedraggable": "^4.1.0",
