{
  "rules": {
    "focusGroupSessions": {
      "$studyId": {
        ".read": "auth != null",

        "consents": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },

        "notes": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },

        "participants": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },

        "messages": {
          "backroom": {
            ".write": "auth != null && (root.child('focusGroupSessions/' + $studyId + '/participants/' + auth.uid + '/accessLevel').val() === 0 || root.child('focusGroupSessions/' + $studyId + '/participants/' + auth.uid + '/accessLevel').val() === 3)"
          },
          "$topicId": {
            ".write": "auth != null"
          }
        },

        "recordings": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },

    "rooms": {
      ".read": true,
      ".write": true
    },
    "calls": {
      ".read": true,
      ".write": true
    }
  }
}
