{
  "rules": {
    "focusGroupSessions": {
      "$studyId": {
        ".read": "auth != null",

        "status": { ".write": "auth != null" },
        "currentTopicIndex": { ".write": "auth != null" },
        "facilitatorId": { ".write": "auth != null" },
        "sessionId": { ".write": "auth != null" },
        "startedAt": { ".write": "auth != null" },
        "focusGroupStartedAt": {
          ".write": "auth != null && root.child('focusGroupSessions/' + $studyId + '/participants/' + auth.uid + '/accessLevel').val() === 0"
        },
        "endedAt": { ".write": "auth != null" },
        "lastUpdate": { ".write": "auth != null" },
        "currentPrompt": { ".write": "auth != null" },
        "currentStimulus": { ".write": "auth != null" },
        "timer": { ".write": "auth != null" },

        "breakout": { ".write": "auth != null" },

        "consents": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },

        "notes": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },

        "participants": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },

        "messages": {
          "$topicId": {
            ".write": "auth != null"
          }
        },

        "recordings": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },

    // A separate top-level path, deliberately NOT nested under
    // focusGroupSessions/$studyId — see the comment on backroomPath in
    // useFocusGroupSession.js for why: RTDB read grants cascade downward
    // from an ancestor and can't be revoked by a stricter rule on a
    // descendant, so a subtree nested under a broadly-readable parent can
    // never actually be read-private. This path is its own subtree, so its
    // .read rule is the only word on who can read it.
    "focusGroupBackroom": {
      "$studyId": {
        ".read": "auth != null && (root.child('focusGroupSessions/' + $studyId + '/participants/' + auth.uid + '/accessLevel').val() === 0 || root.child('focusGroupSessions/' + $studyId + '/participants/' + auth.uid + '/accessLevel').val() === 3)",
        ".write": "auth != null && (root.child('focusGroupSessions/' + $studyId + '/participants/' + auth.uid + '/accessLevel').val() === 0 || root.child('focusGroupSessions/' + $studyId + '/participants/' + auth.uid + '/accessLevel').val() === 3)"
      }
    },

    // Who may write mobileTaskLive/{token}. Written only by Cloud Functions.
    // A client read of this node is denied; rules can still read it.
    "mobileTaskOwners": {
      "$token": {
        ".read": false,
        ".write": false
      }
    },

    // Live task channel for the unmoderated phone. The desktop writes
    // enter, change and finish here so the phone does not wait for a
    // Cloud Function. The phone writes `connected` on the same node.
    // Knowing the token is the capability to read. No .read on the
    // parent, so tokens cannot be listed.
    "mobileTaskLive": {
      "$token": {
        ".read": "$token.matches(/^[a-f0-9]{64}$/)",
        ".write": "auth != null && root.child('mobileTaskOwners/' + $token).val() === auth.uid",
        ".validate": "(newData.hasChildren(['state', 'updatedAt']) && (newData.child('state').val() !== 'active' || newData.hasChildren(['taskNumber', 'title', 'description', 'taskIndex', 'taskId', 'attemptId']))) || (!newData.hasChild('state') && newData.hasChild('connected'))",
        "state": {
          ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'active' || newData.val() === 'accepted' || newData.val() === 'completed')"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "taskNumber": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 1 && newData.val() <= 16)"
        },
        "taskIndex": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 15 && newData.val() % 1 === 0)"
        },
        "taskId": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length > 0 && newData.val().length <= 200)"
        },
        "attemptId": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/))"
        },
        "title": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 2000)"
        },
        "description": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 100000)"
        },
        "connected": {
          ".write": "$token.matches(/^[a-f0-9]{64}$/)",
          ".validate": "!newData.exists() || newData.isBoolean()"
        },
        "$other": { ".validate": false }
      }
    },

    "rooms": {
      ".read": true,
      ".write": true
    },
    "calls": {
      ".read": true,
      ".write": true
    }
  }
}
